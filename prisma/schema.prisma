// CareerOS AI 数据模型 —— 字段来源:PRD 第八节(8.1 实体关系 / 8.2 关键实体字段概览)
// 已确认偏差:
//   1) SkillRadar 不建独立表,六维技能雷达数据并入 CareerProfile.ai_analysis JSON 列;
//   2) CareerProfile 增加画像版本字段(version + parentVersion),任务 2.6/2.7/6.5 依赖;
//   3) M2 批准决策:CareerPath.matchScore 统一为 0~100 整数(PRD/DesignRules 百分比口径);
//      AgentRun 增加 progress JSON 列(1.6 生命周期事件落库,任务 2.4 分析中刷新恢复);
//   4) M3(任务 3.1)调整:任务 3.2 支持「无画像用户手动输入方向」,而 Roadmap.profileId 原为必填外键
//      → profileId 改为可空;同时补 userId 直连列(无画像路线图的所有权链路)与 summary JSON 列(AI 概要)。
//   5) 阶段 6(任务 6.2/6.4):JobMatch 每用户一行(userId 唯一),match_report 与 coach_plan 由两条
//      独立管线先后写入 → 按列 upsert(非替换式),避免一方落库抹掉另一方。
//   6) 阶段 7(任务 7.1):InterviewSession 每用户一行(userId 唯一),对话消息为派生数据不建消息表——
//      questions/answers/report 均存本表 JSON 列;resumeText 为场次快照(开场后简历变更不影响进行中场次)。
// 级联策略(验证要求明确):
//   User 删除 → Cascade CareerProfile / Resume / Roadmap / FunnelEvent(派生事件随用户删除);AgentRun 观测日志保留(SetNull);
//   CareerProfile 删除 → Cascade CareerPath / Roadmap;Roadmap → Cascade Stage → Task;
//   Resume 删除 → Cascade ResumeVersion → Optimization。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  name         String
  avatar       String? // 头像文件 URL,任务 4.1 存储抽象就绪后接入;MVP 使用首字母头像(avatarColor)
  avatarColor  String? // 首字母头像配色(5 预设色之一),任务 1.8 起使用
  passwordHash String? // bcrypt 哈希;邮箱+密码登录必填,未来其他登录方式可为空(仅存哈希,绝不存明文)
  authMethod   String   @default("password") @map("auth_method")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profiles         CareerProfile[]
  resumes          Resume[]
  agentRuns        AgentRun[]
  roadmaps         Roadmap[]
  funnelEvents     FunnelEvent[]
  jobMatch         JobMatch?
  interviewSession InterviewSession?
  linkageHints          LinkageHint[]
  directionResolutions DirectionResolution[]

  @@map("users")
}

model CareerProfile {
  id            String   @id @default(cuid(2))
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version       Int      @default(1) // 画像版本号;同用户每次更新产生新行,活跃版本取最大 version
  parentVersion Int?     @map("parent_version") // 本版本基于的父版本;首个版本为空
  education     Json? // 教育经历(数组)
  skills        Json? // 技能列表
  experiences   Json? // 实习/项目经历(数组)
  interests     Json? // 兴趣方向
  targets       Json? // 目标岗位/行业
  aiAnalysis    Json? @map("ai_analysis") // Profile Agent 分析结果;六维技能雷达数据并入此处(偏差 1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  careerPaths CareerPath[]
  roadmaps    Roadmap[]

  @@map("career_profiles")
}

model CareerPath {
  id            String   @id @default(cuid(2))
  profileId     String   @map("profile_id")
  profile       CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  directionName String   @map("direction_name") // 推荐方向名称
  matchScore    Int      @map("match_score") // 匹配度 0~100 整数(PRD 百分比口径,偏差 3)
  strengths     Json     @default("[]") // 匹配优势(数组)
  weaknesses    Json     @default("[]") // 匹配劣势(数组)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("career_paths")
}

model Roadmap {
  id              String         @id @default(cuid(2))
  userId          String         @map("user_id") // 所有权直连列(3.1:无画像用户也可创建路线图)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?        @map("profile_id") // 可空(3.1):有画像时关联;画像删除仍级联删路线图
  profile         CareerProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetDirection String         @map("target_direction") // 目标方向
  weeklyHours     Int?           @map("weekly_hours") // 每周可投入小时数
  currentStage    String?        @map("current_stage") // 当前阶段自评(完全新手/有一定基础/接近入门)
  summary         Json?          @map("summary") // Navigator Agent 概要(总时长/阶段数/最终目标,任务 3.4)
  createdAt       DateTime       @default(now()) @map("created_at")

  stages Stage[]

  @@index([userId])
  @@map("roadmaps")
}

model Stage {
  id                String  @id @default(cuid(2))
  roadmapId         String  @map("roadmap_id")
  roadmap           Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  name              String // 阶段名
  goal              String // 阶段目标
  order             Int // 阶段顺序(从 1 起)
  estimatedDuration String? @map("estimated_duration") // 预计时长(如「2 周」,PRD 未定类型以文本存储)
  content           Json    @default("{}") // 阶段内容(Navigator Agent 输出:学习内容/项目/检查点)

  tasks Task[]

  @@map("stages")
}

model Task {
  id          String @id @default(cuid(2))
  stageId     String @map("stage_id")
  stage       Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  description String // 任务描述
  type        String // 任务类型(如 学习 / 实践项目)
  status      String @default("pending") // 三态:pending / in_progress / completed(服务器持久化,任务 2.5 依赖)
  order       Int // 任务顺序(从 1 起)
  completedAt DateTime? @map("completed_at") // 最近一次完成时间(5.1 工作台「本周任务」KPI 依据;转为 pending/in_progress 时清空)

  @@map("tasks")
}

model Resume {
  id           String   @id @default(cuid(2))
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalText String?  @map("original_text") @db.Text // 上传简历解析出的原文(4.1:提取失败(如图片型 PDF)时为空,待粘贴补全)
  parsedData   Json?    @map("parsed_data") // 简历解析结果(Resume Agent parse 阶段)
  fileName     String?  @map("file_name") // 原始文件名(粘贴路径为空)
  mimeType     String?  @map("mime_type") // 原始文件 MIME(粘贴路径为空)
  sizeBytes    Int?     @map("size_bytes") // 原始文件字节数(粘贴路径为空)
  storageKey   String?  @map("storage_key") // 加密文件在 BlobStorage 中的键(粘贴路径为空)
  extractError String?  @map("extract_error") // 文本提取失败原因码(no-text/unsupported/invalid),成功为空
  sectionOrder Json?    @map("section_order") // 模块顺序快照(4.10:detectSections 结果,读取时派生 sectionPlan;表单渲染顺序权威 = 用户原文)
  createdAt    DateTime @default(now()) @map("created_at")

  versions ResumeVersion[]

  @@index([userId])
  @@map("resumes")
}

model ResumeVersion {
  id              String    @id @default(cuid(2))
  resumeId        String    @map("resume_id")
  resume          Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  targetDirection String?   @map("target_direction") // 本次优化目标方向
  optimizedText   String?   @map("optimized_text") @db.Text // 优化后全文(4.4 起:最终采纳文本由 accepted 片段合成,此列保留为快照)
  changes         Json      @default("{}") // 变更摘要(结构化,供前后对比)
  atsScore        Int?      @map("ats_score") // ATS 评分(0~100)
  atsReport       Json?     @map("ats_report") // ATS 详细报告(规则子分/LLM 子分/建议/等级,4.6)
  atsScoredAt     DateTime? @map("ats_scored_at") // ATS 评分时间(接受/拒绝改动后据此判定「需重新评分」)
  createdAt       DateTime  @default(now()) @map("created_at")

  optimizations Optimization[]

  @@map("resume_versions")
}

model Optimization {
  id              String        @id @default(cuid(2))
  resumeVersionId String        @map("resume_version_id")
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  category        String? // 修改类别(如 关键词 / 量化表达 / 动词开头)
  originalText    String?       @map("original_text")
  optimizedText   String?       @map("optimized_text")
  reason          String? // 修改理由(AI 解释,设计原则「可信」)
  order           Int           @default(0) @map("order") // 展示顺序(按原文出现位置升序,4.4 落库)
  status          String        @default("pending") @map("status") // pending / accepted / rejected(4.5 接受拒绝可撤销)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("optimizations")
}

model AgentRun {
  id         String   @id @default(cuid(2))
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentName  String   @map("agent_name") // Agent 名称(注册表键)
  intent     String? // 调用意图(Orchestrator 路由依据)
  status     String   @default("running") // running / succeeded / failed
  input      Json? // 输入摘要
  output     Json? // 输出摘要
  error      String? // 失败信息
  progress   Json? // 生命周期进度事件数组(1.6 五阶段文案),任务 2.4 落库供分析中刷新恢复
  durationMs Int?     @map("duration_ms") // 耗时(观测用)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("agent_runs")
}

// 漏斗事件(5.3 部署与观测):关键产品事件埋点。注册 = User.createdAt、画像/路线图生成 = AgentRun
// 既有记录,本表补记无法由既有表推导的事件(如简历导出 = 复制最终文本 / 下载 PDF)。
model FunnelEvent {
  id        String   @id @default(cuid(2))
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String   @map("event") // 事件名,如 resume-export
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, event, createdAt])
  @@map("funnel_events")
}

// 岗位匹配(6.2)+ 技能教练计划(6.4):每用户一行,匹配报告与教练计划由两条独立管线
// 先后按列 upsert(偏差 5)。jdTitle 用于技能分析表单预填目标岗位。
model JobMatch {
  id          String   @id @default(cuid(2))
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jdText      String?  @map("jd_text") @db.Text // 用户粘贴的 JD 原文(纠偏重匹配时重放)
  jdTitle     String?  @map("jd_title") // JD 岗位名(Matching Agent 输出,预填技能分析)
  matchReport Json?    @map("match_report") // Matching Agent 输出(读取方防御解析)
  coachPlan   Json?    @map("coach_plan") // Coach Agent 输出(同上)
  weeklyHours Int?     @map("weekly_hours") // 技能分析表单每周投入小时(重生成时覆盖)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("job_matches")
}

// 模拟面试(7.1):每用户一行(userId 唯一,偏差 6)。对话消息为派生数据不建消息表:
// questions = 出题 Agent 输出 [{id,type,question,followUpHints,evidence}];
// answers = 逐题作答 [{questionId,answer,evaluation|null,followUpQuestion|null,followUpAnswer|null}]
// (evaluation null = 评估失败待重试;followUpAnswer null = 追问已跳过);
// report = 综合报告(7.3)。resumeText/面试类型/题数/目标岗位均为场次快照。
model InterviewSession {
  id                   String   @id @default(cuid(2))
  userId               String   @unique @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewType        String   @map("interview_type") // 行为面 | 技术面 | 案例面
  questionCount        Int      @map("question_count") // 5 | 10 | 15(短/标准/完整三档)
  targetPosition       String   @map("target_position") // 目标岗位(场次快照)
  resumeText           String   @map("resume_text") @db.Text // 简历文本(场次快照,开场后变更不影响进行中场次)
  status               String   @default("in_progress") @map("status") // in_progress | completed
  questions            Json     @map("questions") // 出题 Agent 输出(读取方防御解析)
  currentQuestionIndex Int      @default(0) @map("current_question_index") // 当前待答题目下标(0 起)
  answers              Json     @default("[]") @map("answers") // 逐题作答记录(见模型注释)
  report               Json?    @map("report") // 综合报告(7.3,Interview Report Agent 输出)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("interview_sessions")
}

// 联动提示(8.1b):三条联动规则的「是否已打扰过」去重记录。
// 规则评估是状态派生(读域表),本表只记用户对某版本提示的关闭动作;
// dismissedAt 为空 = 活跃(应展示),非空 = 已关闭(同 (userId, kind, refVersion) 不再骚扰)。
// refVersion 语义按 kind:resume-project = 路线图 id(替换式重新生成 → 新 id → 新提示);
// resume-outdated / roadmap-outdated = 画像版本号(新画像版本 → 新提示,版本隔离不串数据)。
model LinkageHint {
  id          String          @id @default(cuid(2))
  userId      String          @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        LinkageHintKind
  refVersion  String          @map("ref_version")
  dismissedAt DateTime?       @map("dismissed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([userId, kind, refVersion])
  @@index([userId])
  @@map("linkage_hints")
}

enum LinkageHintKind {
  resume_project
  resume_outdated
  roadmap_outdated
}

// 匹配/画像方向冲突裁决(8.1c,agent-design 4.4「记录用户决策」):同一 (画像版本, 匹配方向)
// 的冲突只问一次;再次出现同冲突 → 展示已记录选择,不重复询问。不挂 JobMatch 外键:
// 裁决按 (profileVersion, matchDirection) 关联,跨匹配报告可复用。
model DirectionResolution {
  id               String   @id @default(cuid(2))
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVersion   Int      @map("profile_version")
  profileDirection String   @map("profile_direction")
  matchDirection   String   @map("match_direction")
  choice           String   @map("choice") // prefer_profile | prefer_match | keep_both
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("direction_resolutions")
}
