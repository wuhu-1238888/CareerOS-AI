# 复制为 .env 并按本地环境填写;.env 已被 git 忽略
# 本机 PostgreSQL 连接串(本地开发:postgresql://<用户>:<密码>@localhost:5432/<库名>?schema=public)
DATABASE_URL="postgresql://careeros:your_password@localhost:5432/careeros?schema=public"

# LLM Provider:mock | deepseek | openai | anthropic(开发默认 mock,零费用)
LLM_PROVIDER="mock"
# 各 Provider 的 API Key(按需填写;key 只进 .env,绝不提交)
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# NextAuth v5(任务 1.4):openssl rand -base64 32 生成
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
